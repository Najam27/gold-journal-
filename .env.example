# =============================================================================
# Gold Journal environment template
#
# Targets: Cloudflare Workers (production + staging), the local Node dev
# server (`pnpm dev`), and a standalone Node production server (`pnpm start`).
# No Netlify variables are used anymore.
# =============================================================================

# --- Browser-safe variables (must be VITE_-prefixed; embedded in the build) --
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional browser-safe origin/path for Supabase email confirmation and magic
# links. Leave blank locally. In production set it to the deployed app URL
# (your Cloudflare custom domain) and add the same origin to Supabase Auth →
# URL Configuration → Redirect URLs.
VITE_AUTH_REDIRECT_URL=
# Optional API origin override. Defaults to the app's own origin (/api), which
# is correct for Cloudflare Workers Assets and `pnpm dev`. Set it only when
# the frontend and the API live on different origins (e.g. a preview frontend
# pointed at the production worker: https://app.yourdomain.com).
VITE_API_BASE_URL=

# --- Server-only Supabase variables (never VITE_-prefixed) ------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trade-screenshots

# --- Optional analytics (browser) --------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Server-only settings -----------------------------------------------------
# Long random server-only secret used to encrypt each user's OpenRouter key
# before it is stored in Supabase. Required in production: without it the vault
# falls back to SUPABASE_SERVICE_ROLE_KEY and rotating that key locks out every
# saved AI key. See server/userAiProviderVault.ts.
AI_KEY_ENCRYPTION_SECRET=
# Canonical public origin of this deployment. The API posts durable AI work to
# <origin>/api/ai-job-dispatch (Cloudflare Worker route). Required on
# Cloudflare: set it to the worker's custom domain, e.g.
# https://app.yourdomain.com (or the *.workers.dev URL during staging).
# On `pnpm dev` leave blank; AI jobs then run in-process automatically.
AI_JOB_WORKER_BASE_URL=
# Optional: allow inline (same-process) AI job processing on a long-running
# Node server (local dev via `pnpm dev` sets this implicitly). Never enable on
# Cloudflare Workers: the dispatch route handles jobs there.
AI_JOB_INLINE_FALLBACK=false
# Optional OpenRouter provider timeouts for AI Analysis / AI Mentor / Risk
# Coach, in milliseconds. Default 120000.
OPENROUTER_TIMEOUT_MS=
OPENROUTER_RISK_COACH_TIMEOUT_MS=
# Optional OpenRouter dashboard attribution URL for AI requests.
OPENROUTER_APP_URL=https://<your-deployed-domain>
