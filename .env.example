# Browser-safe Supabase Auth variables
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional browser-safe origin/path for Supabase email confirmation and magic links.
# Leave blank locally; set to the deployed app URL in Netlify if Supabase uses a fixed redirect.
VITE_AUTH_REDIRECT_URL=

# Netlify/server-only Supabase variables
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trade-screenshots

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional server-only OpenRouter Analysis integration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_APP_URL=https://<your-site-domain>
