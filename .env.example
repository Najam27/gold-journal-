# Browser-safe Supabase Auth variables
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional browser-safe origin/path for Supabase email confirmation and magic links.
# Leave blank locally; set to the deployed app URL in Netlify if Supabase uses a fixed redirect.
VITE_AUTH_REDIRECT_URL=

# Netlify/server-only Supabase variables
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trade-screenshots

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server-only settings (never use a VITE_ prefix; browser code must not see them).
# Long random server-only secret used to encrypt each user's OpenRouter key
# before it is stored in Supabase. Required in production: without it the vault
# falls back to SUPABASE_SERVICE_ROLE_KEY and rotating that key locks out every
# saved AI key. See server/userAiProviderVault.ts.
AI_KEY_ENCRYPTION_SECRET=
# Public origin of this deployment, used by the tRPC API to dispatch durable AI
# work to the Netlify Background Function. Example: https://<your-site>.netlify.app
# Netlify normally injects URL/DEPLOY_PRIME_URL into build-time only, so set this
# explicitly for the functions runtime.
AI_JOB_WORKER_BASE_URL=
# Optional: allow inline (same-process) AI job processing. Only enable on a
# long-running Node server (local dev / pnpm dev). Never enable on Netlify
# Functions: the sandbox freezes after the response and jobs stay QUEUED.
AI_JOB_INLINE_FALLBACK=false
# Optional OpenRouter provider timeouts for AI Analysis / AI Mentor / Risk
# Coach, in milliseconds. Default 120000; background functions may use up to
# 840000 (14 minutes).
OPENROUTER_TIMEOUT_MS=
OPENROUTER_RISK_COACH_TIMEOUT_MS=
OPENROUTER_APP_URL=https://<your-site-domain>
